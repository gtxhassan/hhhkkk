{
  "mcpServers": {
    "ai-compliance": {
      "command": "python",
      "args": [
        "/app/mcp/ai_compliance_server.py"
      ],
      "env": {
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}",
        "MODEL": "claude-3-5-sonnet",
        "AI_GOVERNANCE": "enabled",
        "AUDIT_LOGGING": "true"
      }
    },
    "openai-assistant": {
      "command": "python",
      "args": [
        "/app/mcp/openai_server.py"
      ],
      "env": {
        "OPENAI_API_KEY": "${OPENAI_API_KEY}",
        "MODEL": "gpt-4o",
        "EMBEDDINGS": "text-embedding-3-small"
      }
    },
    "local-llm": {
      "command": "ollama",
      "args": [
        "run",
        "qwen2.5:3b"
      ],
      "env": {
        "OLLAMA_HOST": "http://localhost:11434"
      }
    }
  }
}
